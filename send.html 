<!DOCTYPE html>
<html>
<head>
  <title>Secret Story - Envoyer</title>
  <style>
    @keyframes gradient {
      0% {background-position: 0% 50%;}
      50% {background-position: 100% 50%;}
      100% {background-position: 0% 50%;}
    }

    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(270deg, #7c4dff, #ff4081, #18ffff);
      background-size: 600% 600%;
      animation: gradient 20s ease infinite;
      color: #fff;
      text-align: center;
    }

    .container {
      background-color: rgba(0,0,0,0.7);
      padding: 50px;
      border-radius: 20px;
      width: 90%;
      max-width: 700px;
    }

    h2 { font-size: 3em; margin-bottom: 20px; color: #ff4081; }

    textarea {
      font-size: 2em;
      padding: 20px;
      width: 80%;
      height: 150px;
      border-radius: 15px;
      border: none;
      margin: 20px 0;
      background-color: #222;
      color: #fff;
      text-align: center;
      resize: none;
    }

    button {
      font-size: 2em;
      padding: 20px 40px;
      border-radius: 15px;
      border: none;
      background-color: #ff4081;
      color: #fff;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover { background-color: #e91e63; }

    p { font-size: 1.5em; margin-top: 20px; color: #18ffff; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Envoyer un message à Secret Story</h2>
    <textarea id="messageInput" placeholder="Ton message..."></textarea>
    <button onclick="send()">Envoyer</button>
    <p id="info"></p>
  </div>

  <script>
    const username = location.pathname.split("/").pop();

    async function send() {
      const msg = document.getElementById("messageInput").value.trim();
      if (!msg) {
        alert("Veuillez entrer un message !");
        return;
      }

      const r = await fetch("/api/send/" + username, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: msg })
      });

      const d = await r.json();
      if (d.success) {
        document.getElementById("info").innerText = "Message envoyé ! ✅";
        document.getElementById("messageInput").value = "";
      } else {
        document.getElementById("info").innerText = d.error || "Erreur lors de l'envoi";
      }
    }
  </script>
</body>
</html>